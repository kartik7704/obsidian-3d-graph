{
  "name": "3d-graph-new",
  "version": "1.4.0",
  "description": "A 3D graph for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "bun esbuild.config.mjs production",
    "version": "bun version-bump.mjs && git add manifest.json versions.json",
    "release": "bash ./release.sh",
    "prepare": "husky install",
    "typecheck": "tsc -noEmit -skipLibCheck &&  bunx dpdm -T --exit-code circular:1 --warning false --tree false src/main.ts",
    "lint": "eslint . --ext .ts --fix --format unix"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "3D",
    "D3",
    "3D graph",
    "graph"
  ],
  "author": "Hananoshika Yomaru",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/d3": "^7.4.0",
    "@types/eslint": "^8.44.4",
    "@types/node": "^16.11.6",
    "@types/three": "^0.184.1",
    "builtin-modules": "3.3.0",
    "bun-types": "^1.0.5",
    "dpdm": "^3.14.0",
    "esbuild": "0.17.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^8.0.3",
    "obsidian": "1.4.11",
    "prettier": "^2.8.8",
    "semver": "^7.5.4",
    "tslib": "2.4.0",
    "typescript": "5.2.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "3d-force-graph": "1.73.0",
    "@tweenjs/tween.js": "^21.0.0",
    "copy-anything": "^3.0.5",
    "d3": "^7.8.5",
    "d3-force-3d": "^3.0.5",
    "observable-slim": "^0.1.6",
    "obsidian-dataview": "^0.5.61",
    "polytype": "^0.17.0",
    "three": "^0.184.0",
    "ts-essentials": "^10.2.1",
    "zod": "^3.22.4"
  }
}
